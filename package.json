{
  "name": "deepsift",
  "private": true,
  "version": "0.1.0",
  "description": "DEEPSIFT — autonomous science triage for bandwidth-constrained missions (research prototype)",
  "scripts": {
    "demo": "bash scripts/demo.sh",
    "fetch-data": "uv run python scripts/fetch_nasa.py --sols 232-251",
    "api": "PYTHONPATH=services/pipeline uv run uvicorn deepsift.api.app:app --port 8787",
    "web": "cd apps/web && npx next dev -p 3000",
    "test": "uv run pytest -q",
    "benchmark": "PYTHONPATH=services/pipeline uv run python scripts/run_benchmark.py",
    "pipeline": "PYTHONPATH=services/pipeline uv run python scripts/run_pipeline.py"
  }
}
