# /etc/deepsift/collector.env  (chmod 600, owner root:deepsift) — never commit the real file
COLLECTOR_DB=/var/lib/deepsift-observatory/observatory.sqlite
COLLECTOR_BACKUP_DIR=/var/lib/deepsift-observatory/backups
COLLECTOR_BACKUP_KEEP=7
# full API incl. token-protected admin — bound to 127.0.0.1, NEVER tunneled
COLLECTOR_PORT=8790
COLLECTOR_ADMIN_TOKEN=__generate_with__openssl_rand_-hex_32__
# read-only listener — the ONLY port the tunnel exposes; every route except /healthz requires this bearer token
COLLECTOR_PUBLIC_PORT=8791
COLLECTOR_READ_TOKEN=__generate_with__openssl_rand_-hex_32__
# polling (seconds) — defaults shown
POLL_DSN_S=5
POLL_NOAA_S=300
POLL_DONKI_S=600
POLL_HORIZONS_S=300
POLL_CURIOSITY_S=180
POLL_PERSEVERANCE_S=300
# DISABLE_DSN=1   # the DSN adapter is optional; disabling it never affects the other sources
