# Optional. Without keys DEEPSIFT runs with the clearly-labelled mock decision engine
# and reports deep analysis as unavailable.

# Jev (TypeSafe AI) — used automatically when set (decision_engine.kind: auto)
TYPESAFE_API_KEY=

# Deep analysis (Anthropic Claude) — also set deep_analysis.provider: claude
ANTHROPIC_API_KEY=

# UI → API
NEXT_PUBLIC_DEEPSIFT_API=http://localhost:8787
